<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3F8C2A17-9D4B-4E61-A2C5-7B0E8D91F4A2}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>WeaponForge</RootNamespace>
    <AssemblyName>WeaponForge</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- Keeps the builder's absolute paths OUT of the shipped DLL. Without
         this, the PE debug directory embeds the full path to the .pdb
         (C:\Users\<name>\...\obj\Debug\WeaponForge.pdb) and every source file
         path goes into the .pdb - all readable out of a released DLL with
         `strings`. PathMap rewrites them to a relative form; combined with
         Deterministic it also makes the build reproducible. -->
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- $(PunkManaged) is <your PUNK folder>\Punk_Data\Managed and $(PunkCore)
       is <your PUNK folder>\BepInEx\core. Both are resolved by
       Directory.Build.props at the repo root - see BUILDING.md. None of
       these DLLs are redistributed here; they come from your own install. -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(PunkCore)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(PunkCore)\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(PunkCore)\BepInEx.Unity.Mono.dll</HintPath>
    </Reference>
    <Reference Include="MyBox">
      <HintPath>$(PunkManaged)\MyBox.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(PunkManaged)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Punk.Main">
      <HintPath>$(PunkManaged)\Punk.Main.dll</HintPath>
    </Reference>
    <!-- WeaponBase.Fire returns a UniTaskVoid, so the type must be
         resolvable even though we just let the task run. -->
    <Reference Include="UniTask">
      <HintPath>$(PunkManaged)\UniTask.dll</HintPath>
    </Reference>
    <Reference Include="ServiceLocator">
      <HintPath>$(PunkManaged)\ServiceLocator.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes">
      <HintPath>$(PunkManaged)\Sirenix.OdinInspector.Attributes.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(PunkManaged)\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization.Config">
      <HintPath>$(PunkManaged)\Sirenix.Serialization.Config.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Utilities">
      <HintPath>$(PunkManaged)\Sirenix.Utilities.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="Unity.RenderPipelines.Universal.2D.Runtime">
      <HintPath>$(PunkManaged)\Unity.RenderPipelines.Universal.2D.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime">
      <HintPath>$(PunkManaged)\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(PunkManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(PunkManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <!-- Texture2D.LoadImage is an extension method that lives here, not on
         Texture2D itself - needed to build a sprite from a PNG on disk. -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(PunkManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <!-- AudioClip / AudioSource / AudioMixerGroup live here, not in
         UnityEngine.dll - needed to build a sound from a file on disk. -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(PunkManaged)\UnityEngine.AudioModule.dll</HintPath>
    </Reference>
    <!-- Unity has no synchronous decoder for ogg/mp3; UnityWebRequestMultimedia
         is the only runtime route, and it needs both of these. -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(PunkManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(PunkManaged)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(PunkManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(PunkManaged)\UnityEngine.Physics2DModule.dll</HintPath>
    </Reference>
  </ItemGroup>
